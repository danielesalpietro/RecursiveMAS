# ─────────────────────────────────────────────────────────────────────────────
# Enterprise GenAI Platform — Environment Variables
# Copy to .env and fill in your values before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure ────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nfdstY=
AIRFLOW_SECRET_KEY=changeme-airflow-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_PORT=8080
AIRFLOW_UID=50000

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER_UI_PORT=8082
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
LIVY_PORT=8998

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_PORT=5000

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── LLM / Ollama ──────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ── RAG & Mem0 ────────────────────────────────────────────────────────────────
RAG_API_PORT=8000
MEM0_API_PORT=8001

# ── Open WebUI ────────────────────────────────────────────────────────────────
OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=changeme-webui-secret
ENABLE_OAUTH_SIGNUP=false
OPENWEBUI_OAUTH_CLIENT_ID=openwebui
OPENWEBUI_OAUTH_CLIENT_SECRET=openwebui-secret

# ── Superset ──────────────────────────────────────────────────────────────────
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=changeme-superset-secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin123
SUPERSET_OAUTH_CLIENT_ID=superset
SUPERSET_OAUTH_CLIENT_SECRET=superset-secret

# ── Keycloak (SSO) ────────────────────────────────────────────────────────────
KEYCLOAK_PORT=8443
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ── Traefik ───────────────────────────────────────────────────────────────────
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8090

# ── Optional: External LLM providers (leave blank to use local Ollama) ────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
