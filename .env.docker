# ── RecursiveMAS — Docker environment ────────────────────────────────────────
# Copy this file to .env before running docker compose.
# Values here are pre-wired for the Docker internal network.
# Fill in your real API keys; leave optional ones blank to disable the feature.

# ── Required for Deliberation style (web search) ──────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ── HuggingFace token (needed for gated models) ───────────────────────────────
HF_TOKEN=hf_your_token_here

# ── LLM post/pre-processing backends ─────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPAT_ENDPOINT=
OPENAI_COMPAT_MODEL=

# ── mem0 semantic cache ───────────────────────────────────────────────────────
# Pre-wired for Docker internal network — do not change unless running standalone
MEM0_URL=http://mem0:8080
MEM0_PORT=8080
MEM0_THRESHOLD=0.92
MEM0_TIMEOUT_S=3.0

# Optional: enable LLM-based memory extraction inside mem0.
# If set, mem0 uses OpenAI to extract and deduplicate memories.
# Without it, mem0 stores raw Q&A text — sufficient for semantic caching.
OPENAI_API_KEY=

# ── Ports exposed to the host ─────────────────────────────────────────────────
SERVE_PORT=7860
