# ── Required for Deliberation style (web search tool) ────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ── Optional: HuggingFace token (needed for gated models) ────────────────────
HF_TOKEN=hf_your_token_here

# ── Optional: post-processing LLM backends (Chat tab → 🤖 Post-processing) ───
# Leave a key blank to keep that backend disabled in the UI.
# The UI will show ⚠️ "not configured" instead of attempting the call.

# Claude (Anthropic API) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here

# OpenAI-compatible local server (vLLM / Ollama / AnythingLLM)
# Set the base URL of your local server; no key required for most setups.
# OPENAI_COMPAT_ENDPOINT=http://192.168.1.x:8000/v1
# OPENAI_COMPAT_MODEL=llama3

# ── mem0 semantic cache ───────────────────────────────────────────────────────
MEM0_URL=http://localhost:8080       # URL of the mem0 service container
MEM0_THRESHOLD=0.92                  # cosine similarity threshold for cache hit (0–1)
MEM0_TIMEOUT_S=3.0                   # seconds before cache lookup times out (fail-open)
MEM0_PORT=8080                       # host port exposed by the mem0 container

# Optional: enable LLM-based memory extraction inside mem0
# Without this key, mem0 stores raw Q&A text — sufficient for semantic caching.
# OPENAI_API_KEY=sk-your-key-here
