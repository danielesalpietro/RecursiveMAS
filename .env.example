TAVILY_API_KEY=tavily-api-key-here
HF_TOKEN=hf-token-here

# mem0 semantic cache
MEM0_URL=http://localhost:8080       # URL of the mem0 service container
MEM0_THRESHOLD=0.92                  # cosine similarity threshold for cache hit (0-1)
MEM0_TIMEOUT_S=3.0                   # seconds before cache lookup times out (fail-open)
MEM0_PORT=8080                       # host port for mem0 container

# Optional: enable LLM-based memory extraction in mem0
# Without this, mem0 stores raw text — still works fine for semantic caching
OPENAI_API_KEY=